{
  "name": "Apex String Control",
  "description": "Apex branded session controller",
  "repository": "https://github.com/oyevipthoma88/String_control",
  "logo": "https://i.ibb.co/apex-logo.png",
  "keywords": [
    "telegram",
    "telethon",
    "session",
    "apex"
  ],
  "env": {
    "API_ID": {
      "description": "Telegram API_ID from my.telegram.org"
    },
    "API_HASH": {
      "description": "Telegram API_HASH from my.telegram.org"
    },
    "BOT_TOKEN": {
      "description": "Bot token from @BotFather"
    },
    "SUDOERS": {
      "description": "Owner numeric IDs (space-separated)"
    },
    "MONGO_URL": {
      "description": "MongoDB connection string",
      "required": false
    },
    "LOG_GROUP_ID": {
      "description": "Log channel ID",
      "required": false
    },
    "MUST_JOIN": {
      "description": "Force-sub channel username",
      "required": false
    },
    "DISABLED": {
      "description": "Disabled modules e.g. C J",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}